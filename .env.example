# ==== Voice Layer ====

# Rime Text-to-Speech API Configuration
# Leave RIME_API_KEY unset/placeholder to automatically use mock audio
RIME_API_KEY=your_rime_api_key_here
RIME_SPEAKER=marsh
RIME_MODEL_ID=v1
RIME_API_URL=https://users.rime.ai/v1/rime-tts

# Speech-to-Text Configuration
# Options: "speech_recognition", "whisper_local", "gemini_api", or "mock"
STT_ENGINE=whisper_local
GEMINI_API_KEY=your_gemini_api_key_here

# ==== Browser Layer ====

# Set to "true" to run Chromium headless (no visible window). Leave "false"
# for live demo so the browser window is visible.
HEADLESS=false

# Maximum number of ranked products returned per search result set.
# Must be <= 15 (the max_cards cap in extraction.py). Raise both if needed.
MAX_SEARCH_RESULTS=10

# ==== LLM Orchestration ====
# "mock" (default): zero-cost rule-based structured extraction.
# "gemini": real LLM call for query/constraint extraction, needs GEMINI_API_KEY.
LLM_ENGINE=mock
LLM_MODEL=gemini-2.5-flash

# ==== Server ====
HOST=127.0.0.1
PORT=8000
