# ==== Voice Layer ====

# Rime Text-to-Speech API Configuration
# Leave RIME_API_KEY unset/placeholder to automatically use mock audio.
RIME_API_KEY=your_rime_api_key_here

# RIME_SPEAKER: default English voice (used when no per-language mapping applies).
# Must be a valid Coda voice name (see https://docs.rime.ai/docs/voices-coda).
# "astra" is a featured Coda voice: Female, Young Adult, US English.
RIME_SPEAKER=astra

# RIME_MODEL_ID: MUST be "coda" for multilingual support.
# "coda" is Rime's current flagship model: 9 languages, 253 voices.
# The legacy "v1" model is English-only and absent from current Rime docs.
RIME_MODEL_ID=coda

RIME_API_URL=https://users.rime.ai/v1/rime-tts

# Per-language speaker overrides (optional). Each Coda voice serves exactly ONE
# language; if you want a different voice for a language, set the env var below.
# Built-in defaults (from the live Coda voice catalog, August 2026):
#   en -> astra   (162 voices available)
#   es -> brisa   (40 voices)
#   ja -> akari   (13 voices)
#   pt -> rio     (11 voices)
#   de -> aura    (9 voices)
#   fr -> aurelie (8 voices)
#   ar -> layla   (6 voices, Coda only)
#   hi -> nadi    (2 voices, Coda only)
#   it -> livia   (2 voices, Coda only)
#
# Example overrides:
# RIME_SPEAKER_HI=taru        # Switch Hindi to the male voice
# RIME_SPEAKER_ES=celestino   # Switch Spanish to a Mexican male voice
# RIME_SPEAKER_JA=sakura      # Switch Japanese to a different female voice

# Speech-to-Text Configuration
# Options: "speech_recognition", "whisper_local", "gemini_api", or "mock"
# whisper_local: auto-detects spoken language (surfaces result["language"])
# gemini_api:   transcribes but cannot detect language (returns "und")
STT_ENGINE=whisper_local
GEMINI_API_KEY=your_gemini_api_key_here

# ==== Browser Layer ====

# Set to "true" to run Chromium headless (no visible window). Leave "false"
# for live demo so the browser window is visible.
HEADLESS=false

# Maximum number of ranked products returned per search result set.
# Must be <= 15 (the max_cards cap in extraction.py). Raise both if needed.
MAX_SEARCH_RESULTS=10

# ==== LLM Orchestration ====
# "mock" (default): zero-cost rule-based structured extraction.
#   - English-only; degrades gracefully (with a logged warning) for non-English
#     input. If you need real multilingual support, set LLM_ENGINE=gemini.
# "gemini": real LLM call for query/constraint extraction, needs GEMINI_API_KEY.
#   - Supports ANY language Gemini knows.
#   - Adds "query_en" (English translation) and "detected_language" to the
#     structured output, so browser searches always use English search terms.
#   - ONE extra LLM call per non-English turn for translating the spoken response.
#     English is the zero-extra-call fast path.
LLM_ENGINE=mock
LLM_MODEL=gemini-2.5-flash

# ==== Server ====
HOST=127.0.0.1
PORT=8000
